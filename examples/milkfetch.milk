os -> run "grep '^PRETTY_NAME=' /etc/os-release | cut -d= -f2- | cut -c 2- | rev | cut -c 2- | rev"
kernel -> run "uname -r"
logo -> run "grep '^ID_LIKE=' /etc/os-release | cut -d= -f2- | cut -c 2- | rev | cut -c 2- |  rev"
packages -> run "pacman -Q | wc -l"
user -> run "whoami"
cpu -> run "lscpu | grep 'Model name' | cut -d: -f2- | sed 's/^ *//'"

check logo == "arch"
    ascii1 -> "     /\      "
    ascii2 -> "    /  \     "
    ascii3 -> "   /    \    "
    ascii4 -> "  /      \   "
    ascii5 -> " /  |''|  \  "
    ascii6 -> "/_-''  ''-_\ "

check logo == "debian"
    ascii1 -> "  _____   "
    ascii2 -> " /  __ \  "
    ascii3 -> "|  /    | "
    ascii4 -> "|  \__-   "
    ascii5 -> "-_        "
    ascii6 -> "  --_     "

check logo == "gentoo"
    ascii1 -> " _----_    "
    ascii2 -> "(      \   "
    ascii3 -> " \   0  \  "
    ascii4 -> "  /      ) "  
    ascii5 -> " (      /  "
    ascii6 -> " \-___-/   "

check logo == "fedora"
    ascii1 -> "   _____  "
    ascii2 -> "  /  _  \ "
    ascii3 -> "__| |__\/ "
    ascii4 -> "|__  _|   "
    ascii5 -> "__| |     "
    ascii6 -> "\___/     "

check logo == "void"
    ascii1 -> "  ______   "
    ascii2 -> " /  __  \  "
    ascii3 -> "/  /##\  \ "
    ascii4 -> "\  \##/  / "
    ascii5 -> " \______/  "
    ascii6 -> ""
 
show ""
show "{ascii1} OS: {os}"
show "{ascii2} Kernel: {kernel}"
show "{ascii3} Packages: {packages}"
show "{ascii4} User: {user}"
show "{ascii5} CPU: {cpu}"
show "{ascii6}"
